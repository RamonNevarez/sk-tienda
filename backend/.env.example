SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
# Local: sqlite:///instance/store.db
# Render with Persistent Disk mounted at /var/data: sqlite:////var/data/store.db
DATABASE_URL=sqlite:///instance/store.db
CORS_ORIGINS=http://localhost:5173
FLASK_DEBUG=false
PORT=5000